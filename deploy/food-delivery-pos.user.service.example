[Unit]
Description=Food delivery robot controller and local POS
After=default.target

[Service]
Type=simple
WorkingDirectory=__POS_PROJECT_DIR__
Environment=POS_PORT=8765
ExecStart=/bin/bash __POS_PROJECT_DIR__/deploy/run_pos_controller.sh
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=default.target
