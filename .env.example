# Raspberry Pi IP address used by run_rviz2_pc.sh
ip_address=172.30.81.226

# The conventional uppercase spelling is also supported:
# IP_ADDRESS=172.30.81.226

# Optional examples for other runtime settings:
# MOTION_PORT=/dev/ttyACM0
# LIDAR_PORT=/dev/ttyUSB0
# ROS_DOMAIN_ID=0
MOTION_SERIAL_BAUD=115200

# Let slam_bridge own the Arduino serial port when main.py/start_robot.sh run.
# main.py then uses /cmd_vel and /odom over ROS 2.
MOTION_BACKEND=ros
LIDAR_STOP_DIST=0.30
# Tolerance around the odometry parking pose in front of the target table.
TABLE_STOP_TOLERANCE_M=0.10

# Fixed-route navigation correction. Set to 0 for a heading-only A/B test.
CROSS_TRACK_CONTROL=1
CROSS_TRACK_GAIN=1.2
HEADING_GAIN=1.8
MAX_CROSS_TRACK_CORRECTION=0.30
MIN_LINEAR_SPEED=0.10
WAYPOINT_POSITION_TOLERANCE_M=0.10
WAYPOINT_HEADING_TOLERANCE_DEG=5.0

# Replace these defaults with measurements from odometry_calibration_test.py.
ODOM_TRACK_WIDTH_FACTOR=1.185
LEFT_TICK_SCALE=1.0
RIGHT_TICK_SCALE=1.0

# Fixed restaurant route dimensions (meters). These defaults match the
# checked-in restaurant map and docs/scenario.md.
# JUNCTION_X=2.0
# TABLE1_Y=0.6
# TABLE2_Y=0.6

# POS color theme: light or dark.
POS_THEME=dark
