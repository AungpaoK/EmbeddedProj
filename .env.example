# Raspberry Pi IP address used by run_rviz2_pc.sh
ip_address=172.30.81.226

# The conventional uppercase spelling is also supported:
# IP_ADDRESS=172.30.81.226

# Optional examples for other runtime settings:
# MOTION_PORT=/dev/ttyACM0
# LIDAR_PORT=/dev/ttyUSB0
# ROS_DOMAIN_ID=0
MOTION_SERIAL_BAUD=115200

# Let slam_bridge own the Arduino serial port when main.py/start_robot.sh run.
# main.py then uses /cmd_vel and /odom over ROS 2.
MOTION_BACKEND=ros

# Fixed restaurant route dimensions (meters). These defaults match the
# checked-in restaurant map and docs/scenario.md.
# JUNCTION_X=2.0
# TABLE1_Y=0.6
# TABLE2_Y=0.6
